rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. System Counters: Allows global sequential ID increments across all guest sessions
    match /system_counters/{counterId} {
      allow read, write: if true;
    }

    // 2. Public Content: Visitors ko read allow hai
    match /trending_topics/{topicId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if true;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if true;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    match /devotionals/{devotionalId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. User Profiles: Allow read and write for regular and guest users
    match /users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 4. User Ke Banaye Hue Creatives
    match /generatedCreatives/{docId} {
      allow read, write, create: if true;
    }

    // 5. Admin Users
    match /adminUsers/{userId} {
      allow read, write: if true;
    }

    // 6. Favorites
    match /favorites/{favId} {
      allow read, write, create: if true;
    }

    // 7. General Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
