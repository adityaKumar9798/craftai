rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Public Content: Visitors ko read allow hai, create/edit sirf logged-in users / admins
    match /trending_topics/{topicId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /devotionals/{devotionalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. User Profiles: Sirf khud hi apna profile read/write kar sakta hai
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. User Ke Banaye Hue Creatives: Sirf creator hi apne creatives ko read/write kar sakta hai
    match /generatedCreatives/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // 4. Admin Users: Sirf existing admins hi naye admins add/remove kar sakte hain
    match /adminUsers/{userId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data != null;
    }

    // 5. Favorites: Sirf khud hi apne favorites manage kar sakta hai
    match /favorites/{favId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // 6. Default Fallback: Sirf authenticated users hi access kar sakte hain
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
